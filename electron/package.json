{
  "name": "mint-electron",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "node prepare.js && electron-builder --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-everything": "^2026.1.26",
    "better-sqlite3": "^12.11.1",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jose": "^6.2.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mint.aichat",
    "productName": "Mint",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "logger.js",
      "preload.js",
      "ipc/**/*",
      "server-dist/**/*",
      "client-dist/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    }
  }
}
