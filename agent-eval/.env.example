# Mint Agent Eval configuration
# Copy this file to .env and fill in the provider values before running ingest/live.

AI_CHAT_ENCRYPTION_KEY=
MINT_EVAL_API_URL=https://api.example.com
MINT_EVAL_API_KEY=
MINT_EVAL_MODEL_ID=your-model

# Wiki retrieval defaults to hybrid for live evaluation. The embedding client
# currently sends OpenAI-compatible requests without an auth header; use a
# local/no-auth endpoint or extend the embedding client for authenticated APIs.
MINT_EVAL_WIKI_SEARCH_MODE=hybrid
MINT_EVAL_EMBEDDING_API_URL=http://127.0.0.1:11434/v1
MINT_EVAL_EMBEDDING_MODEL=bge-m3
MINT_EVAL_EMBEDDING_DIMENSIONS=1024

# Optional LLM-as-a-Judge provider. Judge requests occur only with --judge.
MINT_EVAL_JUDGE_API_URL=https://api.example.com
MINT_EVAL_JUDGE_API_KEY=
MINT_EVAL_JUDGE_MODEL_ID=your-judge-model

# Optional paths. Defaults are the versioned fixture and temporary isolated paths.
MINT_EVAL_RAW_DIR=./datasets/wiki-rag/raw
MINT_EVAL_FIXTURE_PATH=./datasets/wiki-rag/fixture
MINT_EVAL_WIKI_PATH=/tmp/mint-wiki-rag-ingested
MINT_EVAL_DB_PATH=/tmp/mint-wiki-rag-agent-eval.db
