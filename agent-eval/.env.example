# Mint Agent Eval configuration
# Copy this file to .env and fill in the provider values before running ingest/live.

AI_CHAT_ENCRYPTION_KEY=
MINT_EVAL_API_URL=https://api.example.com
MINT_EVAL_API_KEY=
MINT_EVAL_MODEL_ID=your-model

# Optional paths. Defaults are the versioned fixture and temporary isolated paths.
MINT_EVAL_RAW_DIR=./datasets/wiki-rag/raw
MINT_EVAL_FIXTURE_PATH=./datasets/wiki-rag/fixture
MINT_EVAL_WIKI_PATH=/tmp/mint-wiki-rag-ingested
MINT_EVAL_DB_PATH=/tmp/mint-wiki-rag-agent-eval.db
