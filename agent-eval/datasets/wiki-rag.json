{
  "name": "wiki-rag",
  "version": "1.1.0",
  "metadata": {
    "corpusDir": "wiki-rag/raw",
    "sourceMode": "raw-sources",
    "description": "Mint Wiki/RAG question-level evaluation set built from ten fixed source documents.",
    "capabilityCoverage": ["retrieval", "citation", "abstention", "multi-hop", "security-boundary"],
    "rubricLevels": ["essential", "important", "optional", "veto"]
  },
  "cases": [
    {
      "id": "rag-001",
      "input": "RAG 为什么能缓解企业内部知识问答中的幻觉问题？",
      "tags": ["wiki", "retrieval", "citation"],
      "expected": {
        "mustContainAny": [["检索", "外部知识"], ["幻觉", "错误"]],
        "mustUseTools": ["wiki_search"],
        "mustNotUseTools": ["bash"],
        "maxToolCalls": 3,
        "requiredSourceFiles": ["2026-07-22-rag"],
        "minCitations": 1
      }
    },
    {
      "id": "rag-002",
      "input": "RAG 的典型流水线包含哪些关键步骤？",
      "tags": ["wiki", "retrieval", "citation"],
      "expected": {
        "mustContainAny": [["切分", "chunk"], ["embedding", "向量"], ["检索"], ["生成"]],
        "mustUseTools": ["wiki_search"],
        "maxToolCalls": 3,
        "requiredSourceFiles": ["2026-07-22-rag"],
        "minCitations": 1
      }
    },
    {
      "id": "rag-003",
      "input": "为什么 RAG 需要对知识进行 Chunking？",
      "tags": ["wiki", "retrieval", "citation"],
      "expected": {
        "mustContainAny": [["上下文", "窗口"], ["粒度", "检索"], ["切块", "chunk"]],
        "mustUseTools": ["wiki_search"],
        "maxToolCalls": 3,
        "requiredSourceFiles": ["2026-07-22-rag"],
        "minCitations": 1
      }
    },
    {
      "id": "rag-004",
      "input": "BM25 和向量检索在 RAG 中如何互补？",
      "tags": ["wiki", "retrieval", "citation"],
      "expected": {
        "mustContainAny": [["BM25"], ["向量", "ANN"], ["关键词", "语义"]],
        "mustUseTools": ["wiki_search"],
        "maxToolCalls": 3,
        "requiredSourceFiles": ["2026-07-22-rag"],
        "minCitations": 1
      }
    },
