{
  "scenarios": [
    {
      "id": "agent-status-bar-chat-run",
      "acceptanceCriteria": ["AC-004"],
      "route": "/chat",
      "setup": {
        "routes": [
          {
            "pattern": "**/api/agents",
            "method": "GET",
            "body": {"agents": [{"id": "general", "label": "通用助手", "available": true}]}
          },
          {
            "pattern": "**/api/settings",
            "method": "GET",
            "body": {"showReactSteps": true, "routingMode": "manual"}
          },
          {
            "pattern": "**/api/conversations",
            "method": "GET",
            "body": {"conversations": []}
          },
          {
            "pattern": "**/api/conversations",
            "method": "POST",
            "body": {"conversation": {"id": "conv-status", "title": "New Conversation", "type": "chat", "createdAt": "2026-07-27T00:00:00.000Z", "updatedAt": "2026-07-27T00:00:00.000Z", "lockedAgent": null, "routingMode": "manual"}}
          },
          {
            "pattern": "**/api/conversations/conv-status/messages",
            "method": "GET",
            "body": {"messages": []}
          },
          {
            "pattern": "**/api/conversations/conv-status/messages",
            "method": "POST",
            "contentType": "text/event-stream",
            "body": "data: {\"type\":\"run_started\",\"runId\":\"run-status\",\"sequence\":1}\n\ndata: {\"type\":\"agent_status\",\"runId\":\"run-status\",\"sequence\":2,\"round\":1,\"maxRounds\":3,\"elapsedMs\":12,\"toolCount\":1,\"toolCounts\":{\"wiki_search\":1},\"currentTool\":\"wiki_search\",\"retryCount\":0,\"loopDetected\":false,\"phase\":\"executing_tools\"}\n\ndata: {\"type\":\"agent_status\",\"runId\":\"run-status\",\"sequence\":3,\"round\":1,\"maxRounds\":3,\"elapsedMs\":24,\"toolCount\":1,\"toolCounts\":{\"wiki_search\":1},\"currentTool\":\"wiki_search\",\"retryCount\":0,\"loopDetected\":false,\"phase\":\"completed\"}\n\ndata: {\"type\":\"run_completed\",\"runId\":\"run-status\",\"sequence\":4,\"state\":\"completed\",\"content\":\"已完成\",\"reasoning\":\"\"}\n\n"
          },
          {
            "pattern": "**/api/conversations/conv-status/generate-title",
            "method": "POST",
            "body": {"title": "状态栏测试"}
          }
        ]
      },
      "markers": ["输入消息"],
      "steps": [
        {"action": "assertText", "text": "通用助手"},
        {"action": "fill", "target": {"placeholder": "输入消息..."}, "value": "测试 Agent 状态栏"},
        {"action": "press", "target": {"placeholder": "输入消息..."}, "key": "Enter"},
        {"action": "waitFor", "text": "Agent 已完成", "timeoutMs": 10000},
        {"action": "assertText", "text": "第 1/3 轮"},
        {"action": "assertText", "text": "工具 1 次"},
        {"action": "assertRequests", "contains": "POST"}
      ]
    }
  ]
}
