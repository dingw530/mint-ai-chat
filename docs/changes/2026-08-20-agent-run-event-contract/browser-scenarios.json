            "body": {"conversations": [{"id": "denial", "title": "审批拒绝", "type": "chat", "createdAt": "2026-08-20T09:00:00.000Z", "updatedAt": "2026-08-20T09:00:00.000Z", "lockedAgent": null, "routingMode": "manual"}]}
          },
          {
