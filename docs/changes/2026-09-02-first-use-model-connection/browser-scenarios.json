{
  "scenarios": [
    {
      "id": "settings-model-config-only-in-endpoints",
      "acceptanceCriteria": ["AC-012"],
      "route": "/chat",
      "ignoreConsoleErrors": ["Content Security Policy directive 'frame-ancestors'"],
      "setup": {
        "routes": [
          {
            "pattern": "**/api/settings",
            "method": "GET",
            "body": { "systemPrompt": "", "showReactSteps": true, "routingMode": "manual" }
          },
          { "pattern": "**/api/settings", "method": "PUT", "body": { "success": true } },
          {
            "pattern": "**/api/endpoints",
            "method": "GET",
            "body": {
              "endpoints": [
                {
                  "id": "endpoint-1",
                  "name": "OpenAI",
                  "apiUrl": "https://api.openai.com/v1",
                  "apiKeyMasked": "sk-***",
                  "modelId": "gpt-4o-mini",
                  "apiType": "openai-chat",
                  "category": "text",
                  "isActive": true,
                  "sortOrder": 0,
                  "createdAt": "2026-09-01T00:00:00.000Z",
                  "updatedAt": "2026-09-01T00:00:00.000Z"
                }
              ]
            }
          },
          { "pattern": "**/api/conversations", "method": "GET", "body": { "conversations": [] } },
          { "pattern": "**/api/agents", "method": "GET", "body": { "agents": [] } }
        ]
      },
      "markers": ["Mint", "设置"],
      "steps": [
        { "action": "click", "target": { "role": "button", "name": "设置" } },
        { "action": "waitFor", "target": { "role": "dialog", "name": "设置" }, "timeoutMs": 10000 },
        { "action": "assertText", "text": "通用设置" },
        { "action": "assertNotText", "text": "API URL" },
        { "action": "assertNotText", "text": "API Key" },
        { "action": "assertNotText", "text": "模型 ID" },
        { "action": "click", "target": { "role": "button", "name": "保存" } },
        {
          "action": "waitFor",
          "target": { "text": "设置已保存", "exact": true },
          "timeoutMs": 10000
        },
        { "action": "click", "target": { "role": "button", "name": "模型端点" } },
        { "action": "waitFor", "text": "共 1 个端点配置", "timeoutMs": 10000 },
        { "action": "click", "target": { "role": "button", "name": "编辑" } },
        { "action": "waitFor", "target": { "label": "模型 ID *" }, "timeoutMs": 10000 },
        { "action": "waitFor", "target": { "label": "API URL *" }, "timeoutMs": 10000 },
        { "action": "waitFor", "target": { "label": "API Key (选填)" }, "timeoutMs": 10000 },
        { "action": "waitFor", "target": { "label": "API 类型" }, "timeoutMs": 10000 }
      ],
      "assertRequests": [
        { "method": "GET", "contains": "/api/settings", "status": 200 },
        { "method": "GET", "contains": "/api/endpoints", "status": 200 },
        { "method": "PUT", "contains": "/api/settings", "status": 200 }
      ]
    },
    {
