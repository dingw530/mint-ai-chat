          {"pattern": "**/api/conversations?*", "method": "GET", "body": {"conversations": [{"id": "fixture-conversation", "title": "审批 Fixture", "type": "text", "createdAt": "2026-01-01T00:00:00.000Z", "updatedAt": "2026-01-01T00:00:00.000Z", "lockedAgent": null, "routingMode": "manual"}]}},
          {"pattern": "**/api/conversations", "method": "GET", "body": {"conversations": [{"id": "fixture-conversation", "title": "审批 Fixture", "type": "text", "createdAt": "2026-01-01T00:00:00.000Z", "updatedAt": "2026-01-01T00:00:00.000Z", "lockedAgent": null, "routingMode": "manual"}]}},
          {"pattern": "**/api/endpoints", "method": "GET", "body": {"endpoints": []}},
